{
  "name": "coollaboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:e2e": "npm run test --workspace=e2e"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
